{
  "name": "fsd-tools",
  "productName": "FSD Tools",
  "description": "FSD Tools",
  "author": "WolfsCoding",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun run build:electron",
    "build:electron": "bun build electron/main.ts electron/preload.ts --outdir dist-electron --target node --format cjs --entry-naming [name].cjs --external electron --external electron-updater",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "bun scripts/desktop-dev.ts",
    "dist": "bun run build && bunx --bun electron-builder --win --publish never"
  },
  "trustedDependencies": [
    "electron"
  ],
  "dependencies": {
    "@effect/atom-react": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "effect": "4.0.6",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.48.0",
    "oxlint": "^1.81.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
